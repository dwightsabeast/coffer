{
	"name": "@cofferhq/astro",
	"version": "1.0.0",
	"description": "Astro components for Coffer, Monero payments for EmDash: the tip button and its endpoint, the /pay page and checkout messages.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dwightsabeast/coffer.git",
		"directory": "theme"
	},
	"type": "module",
	"exports": {
		"./PayPage.astro": "./src/PayPage.astro",
		"./page": "./src/page.ts",
		"./TipButton.astro": "./src/TipButton.astro",
		"./tip": "./src/tip.ts",
		"./messages": "./src/messages.ts",
		"./qr": "./src/qr.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"keywords": [
		"astro-component",
		"emdash",
		"monero"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
