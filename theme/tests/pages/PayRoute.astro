---
// The site's src/pages/pay/coffer/[token].astro, as the README gives it (the token comes as a prop here, not a route param).
import PayPage from "../../src/PayPage.astro";
import { preparePayPage } from "../../src/page";
const pay = await preparePayPage(Astro, Astro.props.token);
---
<PayPage pay={pay} title={Astro.props.title} siteName={Astro.props.siteName}><slot name="head" slot="head" /></PayPage>
