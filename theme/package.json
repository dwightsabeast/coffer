		"astro": ">=7.3.5 <8",
		"emdash": ">=1.5.0 <2"
	},
	"devDependencies": {
		"astro": "7.3.5",
		"emdash": "1.5.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"packageManager": "pnpm@12.8.1",
	"publishConfig": {
		"access": "public"
	}
